# Google Sheets API Configuration
# Get your API key from: https://console.cloud.google.com/
GOOGLE_SHEETS_API_KEY=your-api-key-here

# Google Sheet ID (from the sheet URL)
# Format: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEETS_SHEET_ID=1gMBYW-78Nkr7QdO9qUPGvPfrvsNfXTfhW66KU0x9DAA

# Price Data Source (optional)
# Options: yahoo, google, mock
# Default: yahoo
PRICE_SOURCE=google

# Web UI Authentication (optional)
# Set UI_PASSWORD to require a password to access the web interface
UI_PASSWORD=your-password-here
# SESSION_SECRET signs session cookies — generate with: node -e "require('crypto').randomBytes(32).toString('hex')" | pbcopy
SESSION_SECRET=generate-a-random-hex-string
